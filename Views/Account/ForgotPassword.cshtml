@model ban_link_kien_PC.Domain.Auth.ForgotPasswordRequest
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-4 text-center">Quên mật khẩu</h2>
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" />
            </div>
            <div class="text-danger mb-2">
                @Html.ValidationSummary()
            </div>
            <button type="submit" class="btn btn-primary w-100">Gửi mã khôi phục</button>
        </form>
        <p class="mt-3 text-center">
            <a asp-action="Login">Quay lại đăng nhập</a>
        </p>
    </div>
</div>

