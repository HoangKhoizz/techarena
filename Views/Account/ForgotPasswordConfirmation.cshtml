@{
    ViewData["Title"] = "Mã khôi phục đã được tạo";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-3 text-center">Mã khôi phục đã được tạo</h2>
        <p class="mb-3">
            Trong thực tế, mã này sẽ được gửi qua email. Để học cho dễ, hệ thống hiển thị trực tiếp mã ở dưới:
        </p>
        <div class="alert alert-info">
            <strong>Mã khôi phục:</strong> @ViewBag.ResetToken
        </div>
        <p>
            Bây giờ bạn có thể dùng mã này để đặt lại mật khẩu:
        </p>
        <a class="btn btn-primary" asp-action="ResetPassword" asp-route-token="@ViewBag.ResetToken">Đổi mật khẩu</a>
    </div>
</div>

