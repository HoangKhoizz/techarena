@model ban_link_kien_PC.Domain.Auth.ResetPasswordRequest
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-4 text-center">Đặt lại mật khẩu</h2>
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                <input asp-for="NewPassword" type="password" class="form-control" />
            </div>
            <div class="text-danger mb-2">
                @Html.ValidationSummary()
            </div>
            <button type="submit" class="btn btn-primary w-100">Lưu mật khẩu mới</button>
        </form>
    </div>
</div>

