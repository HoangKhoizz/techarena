@model ban_link_kien_PC.Domain.Auth.LoginRequest
@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="ta-container py-4">
    <div class="auth-shell">
        <div class="page-shell">
            <h2>Đăng nhập</h2>
            <p class="auth-subtitle">Truy cập đơn hàng, build PC và theo dõi tồn kho</p>

            @if (TempData["LoginError"] is string loginErr)
            {
                <div class="alert alert-danger py-2">@loginErr</div>
            }

            <div class="auth-oauth mb-3">
                <a class="btn btn-google w-100"
                   asp-action="ExternalLogin"
                   asp-route-provider="Google"
                   asp-route-returnUrl="@returnUrl">
                    <svg class="btn-oauth-icon" viewBox="0 0 48 48" aria-hidden="true">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    Đăng nhập với Google
                </a>
                <button type="button" class="btn btn-facebook w-100 mt-2" disabled title="Sẽ bổ sung sau">
                    <i class="bi bi-facebook btn-oauth-icon-fa"></i>
                    Đăng nhập với Facebook (sắp có)
                </button>
            </div>

            <div class="auth-divider"><span>hoặc</span></div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label">Tài khoản hoặc Email</label>
                    <input asp-for="UsernameOrEmail" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" type="password" />
                </div>
                <div class="text-danger mb-2">
                    @Html.ValidationSummary()
                </div>
                <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
            </form>
            <div class="d-grid gap-2 mt-3">
                <a class="btn btn-outline-secondary" asp-action="ForgotPassword">Quên mật khẩu</a>
            </div>
            <p class="mt-3 text-center">
                Chưa có tài khoản?
                <a asp-action="Register">Đăng ký ngay</a>
            </p>
            <p class="mt-2 text-center small">
                <a asp-controller="Home" asp-action="Index">← Về trang chủ</a>
            </p>
        </div>
    </div>
</div>
