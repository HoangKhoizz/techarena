@model ban_link_kien_PC.Controllers.ChangePasswordFormViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="ta-container py-4 page-shell" style="max-width:520px">
    <h2 class="mb-3">Đổi mật khẩu</h2>
    <div class="card page-card">
        <div class="card-body">
            <form asp-action="ChangePassword" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-12">
                    <label class="form-label" asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                    <input asp-for="CurrentPassword" class="form-control" type="password" required />
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="NewPassword">Mật khẩu mới</label>
                    <input asp-for="NewPassword" class="form-control" type="password" minlength="6" required />
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" minlength="6" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                    <a class="btn btn-outline-secondary" asp-action="Profile">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
