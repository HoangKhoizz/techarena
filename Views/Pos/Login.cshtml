@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập ca POS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Tech Arena</title>
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/pos.css" asp-append-version="true" />
</head>
<body class="pos-body pos-login-page">
    <div class="pos-login-shell">
        <form class="pos-login-card" id="loginForm">
            <div class="pos-login-brand">
                <img src="~/images/logo.svg" alt="Tech Arena" />
                <div>
                    <strong>TECH ARENA</strong>
                    <span>Đăng nhập ca bán hàng</span>
                </div>
            </div>
            <h1>Mở ca POS</h1>
            <p>Nhân viên / Admin đăng nhập để vào quầy linh kiện.</p>
            <label>
                Tài khoản
                <input type="text" id="loginUser" autocomplete="username" placeholder="username" required autofocus />
            </label>
            <label>
                Mật khẩu
                <input type="password" id="loginPass" autocomplete="current-password" placeholder="••••••" required />
            </label>
            <button type="submit" class="pos-btn primary block">Vào quầy</button>
            <p class="pos-hint">Demo Staff: admin / Admin@123</p>
            <p class="pos-error" id="loginError" hidden></p>
        </form>
    </div>
    <script src="~/js/pos-login.js" asp-append-version="true"></script>
</body>
</html>
