@model ban_link_kien_PC.Controllers.CheckoutSuccessViewModel
@{
    ViewData["Title"] = "Đặt hàng thành công";
    var payUrlJson = System.Text.Json.JsonSerializer.Serialize(Model.MoMoPayUrl ?? "");
}

<div class="ta-container py-4">
<div class="page-shell checkout-success-shell">
    @if (Model.JustPaid && !Model.ShowMoMoQr)
    {
        <div class="alert alert-success">Thanh toán MoMo thành công — đơn đã được cập nhật trạng thái <strong>Đã thanh toán</strong>.</div>
    }

    <div class="alert alert-success">
        <h4 class="alert-heading mb-2">Đặt hàng thành công!</h4>
        <div>Mã đơn: <strong>#@Model.OrderId</strong></div>
        <div>Trạng thái: <strong id="orderStatusDisplay">@Model.StatusDisplay</strong></div>
        <div>Thanh toán: <strong>@Model.PaymentMethodCode</strong></div>
        @if (TempData["OrderNotifyInApp"] as string == "1")
        {
            <div class="mt-2 small">Đã gửi thông báo trên tài khoản của bạn (chuông thông báo).</div>
        }
        @if (TempData["OrderNotifyEmailSent"] as string == "1")
        {
            <div class="mt-1 small">Đã gửi email xác nhận tới <strong>@TempData["OrderNotifyEmail"]</strong>.</div>
        }
        else if (TempData["OrderNotifyEmail"] is string mailTo && !string.IsNullOrWhiteSpace(mailTo))
        {
            <div class="mt-1 small text-muted">
                Email xác nhận sẽ gửi tới <strong>@mailTo</strong>
                @(TempData["OrderNotifyHint"] is string hint ? $" — {hint}" : " khi bật SMTP trong cấu hình.").
            </div>
        }
        else
        {
            <div class="mt-1 small text-muted">Thông báo đặt hàng thành công đã hiển thị trên màn hình này.</div>
        }
        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="mt-2 small">Lưu mã đơn <strong>#@Model.OrderId</strong> và SĐT <strong>@Model.ReceiverPhone</strong> để <a asp-controller="OrderLookup" asp-action="Index" asp-route-phone="@Model.ReceiverPhone" asp-route-orderId="@Model.OrderId">theo dõi đơn</a> sau.</div>
        }
    </div>

    @if (Model.ShowMoMoQr && !string.IsNullOrWhiteSpace(Model.MoMoPayUrl))
    {
        <div class="card page-card mb-3 border-primary">
            <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                <span>Thanh toán MoMo — Quét mã QR</span>
                <span class="badge text-bg-secondary" id="momoPollBadge">Đang chờ quét…</span>
            </div>
            <div class="card-body text-center">
                <p class="mb-3">Mở app MoMo trên điện thoại và quét mã bên dưới.</p>
                <div id="momoQrWrap" class="d-inline-block p-3 bg-white rounded border mb-3">
                    <div id="momoQrCode"></div>
                </div>
                <div id="momoLoading" class="mb-3">
                    <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                    <div class="small text-muted mt-2">Đang chờ xác nhận thanh toán…</div>
                </div>
                <div id="momoPaidOk" class="alert alert-success d-none mb-3">Đã nhận thanh toán thành công!</div>
                @if (Model.MoMoIsDemo)
                {
                    <button type="button" class="btn btn-primary" id="btnDemoPay">Thanh toán demo (giả lập quét mã)</button>
                    <p class="small text-muted mt-2 mb-0">Chế độ sandbox — nút trên giả lập IPN MoMo.</p>
                }
                else
                {
                    <a class="btn btn-outline-secondary btn-sm" href="@Model.MoMoPayUrl" target="_blank" rel="noopener">Mở trang MoMo (nếu không quét được)</a>
                }
            </div>
        </div>
    }

    <div class="card page-card mb-3">
        <div class="card-header fw-semibold">Thông tin giao hàng</div>
        <div class="card-body">
            <div><strong>Người nhận:</strong> @Model.ReceiverName</div>
            <div><strong>SĐT:</strong> @Model.ReceiverPhone</div>
            <div><strong>Địa chỉ:</strong> @Model.ShippingAddress</div>
        </div>
    </div>

    <div class="card page-card">
        <div class="card-header fw-semibold">Chi tiết đơn hàng</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@line.Name</div>
                                <div class="small text-muted">@line.Sku</div>
                            </td>
                            <td class="text-center">@line.Qty</td>
                            <td class="text-end">@line.UnitPriceVnd.ToString("N0") đ</td>
                            <td class="text-end">@line.LineTotalVnd.ToString("N0") đ</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        @if (Model.DiscountAmountVnd > 0)
                        {
                            <tr>
                                <th colspan="3" class="text-end">Tạm tính</th>
                                <th class="text-end">@Model.SubtotalVnd.ToString("N0") đ</th>
                            </tr>
                            <tr>
                                <th colspan="3" class="text-end text-success">
                                    Giảm giá@(string.IsNullOrWhiteSpace(Model.PromoCode) ? "" : $" ({Model.PromoCode})")
                                </th>
                                <th class="text-end text-success">-@Model.DiscountAmountVnd.ToString("N0") đ</th>
                            </tr>
                        }
                        <tr>
                            <th colspan="3" class="text-end">Thanh toán</th>
                            <th class="text-end text-danger">@Model.TotalPriceVnd.ToString("N0") đ</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2 flex-wrap">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Về trang chủ</a>
        <a asp-controller="OrderLookup" asp-action="Details" asp-route-id="@Model.OrderId" asp-route-phone="@Model.ReceiverPhone" class="btn btn-outline-primary">Xem / Hủy đơn</a>
        <a asp-controller="OrderLookup" asp-action="Index" asp-route-phone="@Model.ReceiverPhone" class="btn btn-outline-secondary">Theo dõi đơn</a>
    </div>
</div>
</div>

@if (Model.ShowMoMoQr && !string.IsNullOrWhiteSpace(Model.MoMoPayUrl))
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        (function () {
            const orderId = @Model.OrderId;
            const payUrl = @Html.Raw(payUrlJson);
            const qrEl = document.getElementById('momoQrCode');
            if (qrEl && payUrl && typeof QRCode !== 'undefined') {
                new QRCode(qrEl, { text: payUrl, width: 220, height: 220, correctLevel: QRCode.CorrectLevel.M });
            }

            let timer = null;
            const badge = document.getElementById('momoPollBadge');
            const loading = document.getElementById('momoLoading');
            const paidOk = document.getElementById('momoPaidOk');
            const statusDisplay = document.getElementById('orderStatusDisplay');

            async function poll() {
                try {
                    const res = await fetch('/api/payments/' + orderId + '/status');
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data.paid) {
                        clearInterval(timer);
                        if (badge) {
                            badge.className = 'badge text-bg-success';
                            badge.textContent = 'Đã thanh toán';
                        }
                        if (loading) loading.classList.add('d-none');
                        if (paidOk) paidOk.classList.remove('d-none');
                        if (statusDisplay) statusDisplay.textContent = data.statusDisplay || 'Đã thanh toán';
                        const demoBtn = document.getElementById('btnDemoPay');
                        if (demoBtn) demoBtn.disabled = true;
                    }
                } catch (_) { /* ignore */ }
            }

            timer = setInterval(poll, 2500);
            poll();

            const demoBtn = document.getElementById('btnDemoPay');
            if (demoBtn) {
                demoBtn.addEventListener('click', async function () {
                    demoBtn.disabled = true;
                    demoBtn.textContent = 'Đang xác nhận…';
                    try {
                        const res = await fetch('/api/payments/momo/demo-confirm/' + orderId, { method: 'POST' });
                        const data = await res.json();
                        if (!res.ok) {
                            alert(data.error || 'Thất bại');
                            demoBtn.disabled = false;
                            demoBtn.textContent = 'Thanh toán demo (giả lập quét mã)';
                            return;
                        }
                        await poll();
                    } catch (e) {
                        alert('Lỗi kết nối');
                        demoBtn.disabled = false;
                    }
                });
            }
        })();
    </script>
}
