@model ban_link_kien_PC.Controllers.CustomerEditViewModel
@{
    var isEdit = Model.CustomerId > 0;
    ViewData["Title"] = isEdit ? $"Sửa · {Model.Username}" : "Thêm khách hàng";
    Layout = "_AdminLayout";
}

<div class="page-shell staff-admin">
    <h2 class="mb-3">@(isEdit ? $"Sửa khách hàng #{Model.CustomerId}" : "Thêm khách hàng mới")</h2>

    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        @if (isEdit)
        {
            <input type="hidden" asp-for="CustomerId" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-md-4">
            <label class="form-label" asp-for="Username">Username *</label>
            <input asp-for="Username" class="form-control" required />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="Email">Email *</label>
            <input asp-for="Email" class="form-control" type="email" required />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="Password">Mật khẩu @(isEdit ? "(để trống = giữ nguyên)" : "*")</label>
            <input asp-for="Password" class="form-control" type="text" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="FullName">Họ tên</label>
            <input asp-for="FullName" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="Phone">Số điện thoại</label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="DateOfBirth">Ngày sinh</label>
            <input asp-for="DateOfBirth" class="form-control" type="date" />
        </div>
        <div class="col-12">
            <label class="form-label" asp-for="ShippingAddress1">Địa chỉ giao hàng 1</label>
            <input asp-for="ShippingAddress1" class="form-control" />
        </div>
        <div class="col-12">
            <label class="form-label" asp-for="ShippingAddress2">Địa chỉ giao hàng 2</label>
            <input asp-for="ShippingAddress2" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="BankAccountInfo">Tài khoản ngân hàng</label>
            <input asp-for="BankAccountInfo" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="LoyaltyPoints">Điểm tích lũy</label>
            <input asp-for="LoyaltyPoints" class="form-control" type="number" min="0" />
            <div class="form-text">Hạng tự tính: Bạc≥100, Vàng≥500, Bạch kim≥1500</div>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="IsActive" class="form-check-input" />
                <label class="form-check-label" asp-for="IsActive">Kích hoạt</label>
            </div>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
