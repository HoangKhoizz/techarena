@model ban_link_kien_PC.Controllers.CustomerIndexViewModel
@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "_AdminLayout";
}

<div class="page-shell staff-admin">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="mb-1">Quản lý khách hàng</h2>
            <p class="text-muted mb-0 small">Customer · điểm tích lũy · hạng thẻ. Không hiện mật khẩu.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a class="btn btn-primary btn-sm" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm khách</a>
            <span class="badge text-bg-secondary">@Model.TotalCount khách</span>
        </div>
    </div>

    @if (TempData["AdminInfo"] is string info)
    {
        <div class="alert alert-success py-2">@info</div>
    }

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-6">
            <input name="keyword" value="@Model.Keyword" class="form-control"
                   placeholder="Tìm theo tên, SĐT, email, username..." />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Tìm</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </form>

    <div class="card page-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0 staff-table">
                    <thead>
                        <tr>
                            <th style="width:70px">ID</th>
                            <th>Tên</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th class="text-center">Điểm</th>
                            <th>Hạng</th>
                            <th>Ngày đăng ký</th>
                            <th class="text-center">Tổng đơn</th>
                            <th class="text-center">Trạng thái</th>
                            <th style="width:260px"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="10" class="text-muted text-center py-4">Không có khách hàng.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in Model.Rows)
                        {
                            <tr class="@(row.IsActive ? "" : "opacity-75")">
                                <td>@row.CustomerId</td>
                                <td>
                                    <div class="fw-semibold">@row.FullName</div>
                                    <div class="small text-muted">@@@row.Username</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(row.Phone) ? "—" : row.Phone)</td>
                                <td>@row.Email</td>
                                <td class="text-center">@row.LoyaltyPoints</td>
                                <td><span class="badge text-bg-primary">@row.MembershipTierDisplay</span></td>
                                <td>@row.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center"><span class="badge text-bg-info">@row.OrderCount</span></td>
                                <td class="text-center">
                                    @if (row.IsActive)
                                    {
                                        <span class="badge text-bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Đã khóa</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@row.CustomerId">Chi tiết</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@row.CustomerId">Sửa</a>
                                    <form asp-action="ToggleActive" method="post" class="d-inline"
                                          onsubmit="return confirm('@(row.IsActive ? "Khóa" : "Mở khóa") tài khoản @row.Username?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.CustomerId" />
                                        <button type="submit" class="btn btn-sm @(row.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                            @(row.IsActive ? "Khóa" : "Mở")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Phân trang khách hàng">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-keyword="@Model.Keyword">Trước</a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-keyword="@Model.Keyword">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-keyword="@Model.Keyword">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
